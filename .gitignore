# Python virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables / secrets
.env
.env.*

# Keep the example configuration
!.env.example

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Generated application data
backend/data/raw_documents/*
backend/data/processed/*
backend/data/vector_store/*

# Keep directory structure
!backend/data/raw_documents/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/vector_store/.gitkeep