LLM_PROVIDER=huggingface
HF_TOKEN=
LLM_MODEL=google/flan-t5-base
LLM_SYSTEM_PROMPT=You are a grounded assistant. Use only the provided context. Do not use outside knowledge or invent facts. If the context is insufficient, say so clearly. Keep the answer concise and preserve factual meaning.
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.2

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

FAISS_INDEX_PATH=./data/vector_store

CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
# Set to a cosine-similarity value in [-1, 1]; -1 disables filtering until calibrated.
SIMILARITY_THRESHOLD=-1.0
